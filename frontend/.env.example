# URL backend Laravel.
# - Development (pakai Vite proxy): biarkan kosong '' agar /api & /oauth di-proxy otomatis.
#   VITE_BACKEND_URL = target proxy dev (default http://localhost:8000).
# - Production (domain terpisah): isi URL backend absolut, contoh:
#   VITE_API_URL=https://api.rencanaku.com
VITE_API_URL=
VITE_BACKEND_URL=http://localhost:8000

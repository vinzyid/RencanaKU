# .env.production RencanaKU — template.
#
# setup-vps.sh menyalin berkas ini ke ~/rencanaku/.env.production lalu mengisi
# APP_URL, APP_FRONTEND_URL, CORS, redirect OAuth, dan APP_KEY secara otomatis.
# Sisanya (DB_*, kunci AI, OAuth, MAIL_*) salin dari backend/.env di laptop.
#
# JANGAN di-commit. Setelah mengubah berkas ini jalankan ./deploy.sh
# (atau docker compose up -d --force-recreate).

APP_NAME=RencanaKU
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://DOMAIN_RENCANAKU
APP_FRONTEND_URL=https://DOMAIN_RENCANAKU
CORS_ALLOWED_ORIGINS=https://DOMAIN_RENCANAKU

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database: Supabase (Postgres, Session Pooler port 5432) ---
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# --- Autentikasi ---
# Token Bearer murni: biarkan kosong (lihat config/sanctum.php).
SANCTUM_STATEFUL_DOMAINS=
AUTH_REMEMBER_MINUTES=43200
AUTH_SESSION_MINUTES=1440
# Email yang otomatis jadi admin (pisahkan dengan koma).
ADMIN_EMAILS=

# --- Social login ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://DOMAIN_RENCANAKU/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://DOMAIN_RENCANAKU/oauth/github/callback

# --- AI (chain: GripHub -> OpenRouter -> Gemini -> lokal) ---
GRIPHUB_BASE_URL=https://griphubrouter.web.id/v1
GRIPHUB_API_KEY=
GRIPHUB_MODEL=deepseek-v4-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_REQUEST_TIMEOUT=60
AI_MAX_TOKENS=4096

# --- Green computing (estimasi) ---
GREEN_KWH_PER_1K_TOKENS=0.004
GREEN_CO2_KG_PER_KWH=0.4
GREEN_WATER_L_PER_KWH=1.8
GREEN_AVG_TOKEN_TARGET=1500

# --- Sesi, cache, antrean ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
# Job AI bisa sampai 300 detik; harus lebih besar dari --timeout worker (310)
# supaya job yang masih jalan tidak diambil ulang.
DB_QUEUE_RETRY_AFTER=330

# --- Mail (Gmail SMTP, untuk "Lupa Kata Sandi") ---
# MAIL_PASSWORD = App Password 16 huruf TANPA spasi.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=RencanaKU

# --- Seeder akun admin (opsional, untuk php artisan db:seed --class=AdminUserSeeder) ---
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
DEMO_SEED_EMAIL=
DEMO_SEED_PASSWORD=
